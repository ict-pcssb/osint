{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/$defs/preview"
    },
    {
      "$ref": "#/$defs/commit"
    },
    {
      "$ref": "#/$defs/discard"
    },
    {
      "$ref": "#/$defs/operation"
    },
    {
      "$ref": "#/$defs/plan"
    }
  ],
  "$defs": {
    "preview": {
      "type": "object",
      "required": [
        "scope_dates",
        "instruction",
        "base_revision"
      ],
      "additionalProperties": false,
      "properties": {
        "scope_dates": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "date"
          },
          "minItems": 1,
          "maxItems": 30,
          "uniqueItems": true
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "base_revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "commit": {
      "type": "object",
      "required": [
        "proposal_id",
        "base_revision",
        "idempotency_key",
        "confirmed"
      ],
      "additionalProperties": false,
      "properties": {
        "proposal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[\\w.:-]+$"
        },
        "base_revision": {
          "type": "integer",
          "minimum": 1
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[\\w.-]+$"
        },
        "confirmed": {
          "const": true
        }
      }
    },
    "discard": {
      "type": "object",
      "required": [
        "proposal_id",
        "base_revision"
      ],
      "additionalProperties": false,
      "properties": {
        "proposal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[\\w.:-]+$"
        },
        "base_revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "operation": {
      "type": "object",
      "required": [
        "idempotency_key"
      ],
      "additionalProperties": false,
      "properties": {
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[\\w.-]+$"
        }
      }
    },
    "plan": {
      "type": "object",
      "required": [
        "operations",
        "points",
        "routes",
        "unknown_cost_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "operations": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "op",
                  "date",
                  "stop_id",
                  "new_stop_id",
                  "point_id",
                  "arrive",
                  "leave",
                  "ticket_fen"
                ],
                "additionalProperties": false,
                "properties": {
                  "op": {
                    "const": "replace"
                  },
                  "date": {
                    "type": "string",
                    "format": "date"
                  },
                  "stop_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120,
                    "pattern": "^[\\w.:-]+$"
                  },
                  "new_stop_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120,
                    "pattern": "^[\\w.:-]+$"
                  },
                  "point_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120,
                    "pattern": "^[\\w.:-]+$"
                  },
                  "arrive": {
                    "type": "string",
                    "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                  },
                  "leave": {
                    "type": "string",
                    "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                  },
                  "ticket_fen": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1,
                    "maximum": 1000000
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "op",
                  "date",
                  "after_id",
                  "new_stop_id",
                  "point_id",
                  "arrive",
                  "leave",
                  "ticket_fen"
                ],
                "additionalProperties": false,
                "properties": {
                  "op": {
                    "const": "add"
                  },
                  "date": {
                    "type": "string",
                    "format": "date"
                  },
                  "after_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "maxLength": 120,
                    "pattern": "^[\\w.:-]+$"
                  },
                  "new_stop_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120,
                    "pattern": "^[\\w.:-]+$"
                  },
                  "point_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120,
                    "pattern": "^[\\w.:-]+$"
                  },
                  "arrive": {
                    "type": "string",
                    "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                  },
                  "leave": {
                    "type": "string",
                    "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                  },
                  "ticket_fen": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1,
                    "maximum": 1000000
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "op",
                  "date",
                  "stop_id"
                ],
                "additionalProperties": false,
                "properties": {
                  "op": {
                    "const": "remove"
                  },
                  "date": {
                    "type": "string",
                    "format": "date"
                  },
                  "stop_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120,
                    "pattern": "^[\\w.:-]+$"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "op",
                  "date",
                  "stop_id",
                  "arrive",
                  "leave"
                ],
                "additionalProperties": false,
                "properties": {
                  "op": {
                    "const": "retime"
                  },
                  "date": {
                    "type": "string",
                    "format": "date"
                  },
                  "stop_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120,
                    "pattern": "^[\\w.:-]+$"
                  },
                  "arrive": {
                    "type": "string",
                    "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                  },
                  "leave": {
                    "type": "string",
                    "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                  }
                }
              }
            ]
          },
          "minItems": 1
        },
        "points": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": [
              "id",
              "poi_id",
              "label",
              "latitude",
              "longitude"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[\\w.:-]+$"
              },
              "poi_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[\\w.:-]+$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "latitude": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "longitude": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "source_url": {
                "type": "string",
                "format": "uri"
              },
              "collected_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "routes": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "from_id",
              "to_id",
              "mode",
              "distance_m",
              "duration_s"
            ],
            "additionalProperties": false,
            "properties": {
              "from_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[\\w.:-]+$"
              },
              "to_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[\\w.:-]+$"
              },
              "mode": {
                "enum": [
                  "walk",
                  "car"
                ]
              },
              "distance_m": {
                "type": "integer",
                "minimum": 1
              },
              "duration_s": {
                "type": "integer",
                "minimum": 1,
                "maximum": 86400
              },
              "checked_at": {
                "type": "string",
                "format": "date-time"
              },
              "source_url": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        },
        "unknown_cost_ids": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[\\w.:-]+$"
          },
          "uniqueItems": true
        },
        "quote_expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
